{
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "make": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Override: vehicle make",
            "title": "Make"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Override: vehicle model",
            "title": "Model"
          },
          "upload_id": {
            "description": "Upload ID from /upload endpoint",
            "pattern": "^[0-9a-f]{12}$",
            "title": "Upload Id",
            "type": "string"
          },
          "use_consensus": {
            "default": false,
            "description": "Run both AI providers and merge results for higher confidence (slower, costs more)",
            "title": "Use Consensus",
            "type": "boolean"
          },
          "vin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional VIN for precise identification",
            "title": "Vin"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Override: vehicle year",
            "title": "Year"
          }
        },
        "required": [
          "upload_id"
        ],
        "title": "AnalyzeRequest",
        "type": "object"
      },
      "AngleGuidance": {
        "properties": {
