# AI Provider — "gemini" (default, free tier for dev) or "openai" (production)
AI_PROVIDER=gemini

# Gemini API key (get free at https://aistudio.google.com/apikey)
# Accepts either GEMINI_API_KEY or GOOGLE_AI_GEMINI_API_KEY
GEMINI_API_KEY=your-gemini-key-here

# OpenAI API key (required when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here

# Web search for live part prices (get free key at https://serpapi.com)
SERPAPI_KEY=your-serpapi-key-here

# PostgreSQL connection (asyncpg driver)
# Local dev default — override for production
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/carcrash

# Optional — Override defaults
# LABOR_RATE_PER_HOUR=75.00
# PRICE_CACHE_TTL_HOURS=24
# SEVERITY_REPLACE_THRESHOLD=0.3

# Access control (comma-separated). Empty API_KEYS = auth off (development only).
# APP_ENV=production refuses to start without keys, with CORS_ORIGINS=*, or
# without REDACTION_REQUIRED=true.
# APP_ENV=development
# API_KEYS=
# CORS_ORIGINS=http://localhost:3000,http://localhost:8501
# RATE_LIMIT_PER_MINUTE=120
# ANALYZE_RATE_LIMIT_PER_MINUTE=10
# REDACTION_REQUIRED=false
