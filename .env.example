# Used by docker-compose (repo root). Copy to `.env` and fill in.
# For running the API outside Docker, use backend/.env.example instead.

AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
SERPAPI_KEY=

# Access control. Leave API_KEYS empty for open local development;
# APP_ENV=production requires keys and explicit CORS origins.
APP_ENV=development
API_KEYS=
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
